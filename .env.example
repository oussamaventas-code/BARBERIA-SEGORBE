# Copia este archivo como .env y rellena con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API). La "anon key" es pública por diseño:
# la seguridad la garantizan las políticas RLS de la base de datos.
# NUNCA pongas aquí la "service_role key".
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
